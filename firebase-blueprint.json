        "documentId",
        "versionId",
        "originalFilename",
        "storagePath",
        "contentType",
        "size",
        "uploadedBy",
        "uploadedAt",
        "accessLevel",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
