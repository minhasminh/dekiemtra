# ============================================================================
# 1. BIẾN MÔI TRƯỜNG BÍ MẬT PHÍA BACKEND (TUYỆT ĐỐI KHÔNG GẮN TIỀN TỐ VITE_)
# Không bao giờ nhúng GEMINI_API_KEY hoặc Service Account Private Key vào Frontend
# ============================================================================
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================================================
# 2. CẤU HÌNH FIREBASE WEB SDK CHO FRONTEND (THEO QUY ƯỚC VITE_*)
# Nếu không khai báo trong .env, hệ thống tự động đọc từ firebase-applet-config.json
# ============================================================================
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ============================================================================
# 3. CẤU HÌNH MÔI TRƯỜNG VẬN HÀNH & FEATURE FLAGS (DEVELOPMENT | STAGING | PRODUCTION)
# Mặc định hoạt động chính thức ở chế độ PRODUCTION (Production-Only UI).
# ============================================================================
NODE_ENV=production
PORT=3000
APP_RUNTIME_ENV=PRODUCTION
VITE_APP_RUNTIME_ENV=PRODUCTION
VITE_ENABLE_DEBUG_UI=false
VITE_ENABLE_SAMPLE_DATA_TOOLS=false
VITE_ENABLE_QA_TEST_RUNNER=false

