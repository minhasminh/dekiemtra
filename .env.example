# ============================================================================
# 1. BIẾN MÔI TRƯỜNG BÍ MẬT PHÍA BACKEND (TUYỆT ĐỐI KHÔNG GẮN TIỀN TỐ VITE_)
# Không bao giờ nhúng GEMINI_API_KEY hoặc Service Account Private Key vào Frontend
# ============================================================================
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Personal Access Token của GitHub có quyền Contents: Read & Write (giữ bí mật ở máy chủ Backend)
GITHUB_TOKEN=
# Cấu hình kho chứa dữ liệu trên GitHub (ví dụ: minhasminh/dekiemtra)
GITHUB_DATA_OWNER=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=main
GITHUB_DATA_PATH=data/edutest_multitenant_db.json
GITHUB_DATA_AUTOSYNC=true

# ============================================================================
# 2. CẤU HÌNH FIREBASE WEB SDK CHO FRONTEND (THEO QUY ƯỚC VITE_*)
# Nếu không khai báo trong .env, hệ thống tự động đọc từ firebase-applet-config.json
# ============================================================================
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ============================================================================
# 3. CẤU HÌNH MÔI TRƯỜNG VẬN HÀNH & FEATURE FLAGS (DEVELOPMENT | STAGING | PRODUCTION)
# Mặc định hoạt động chính thức ở chế độ PRODUCTION (Production-Only UI).
# ============================================================================
NODE_ENV=production
PORT=3000
# Thư mục lưu dữ liệu bền vững ngoài releases/ khi dùng AutoDeploy (tuỳ chọn)
DATA_DIR=
# Danh sách tên miền Frontend được phép gọi API nếu tách riêng domain (ngăn cách bằng dấu phẩy, tuỳ chọn)
ALLOWED_ORIGINS=
# URL máy chủ Backend nếu Frontend triển khai tách rời dạng tĩnh (để trống nếu chạy chung domain)
VITE_API_BASE_URL=
APP_RUNTIME_ENV=PRODUCTION
VITE_APP_RUNTIME_ENV=PRODUCTION
VITE_ENABLE_DEBUG_UI=false
VITE_ENABLE_SAMPLE_DATA_TOOLS=false
VITE_ENABLE_QA_TEST_RUNNER=false

