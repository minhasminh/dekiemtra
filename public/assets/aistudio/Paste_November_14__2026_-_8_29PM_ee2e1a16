                    btn.className = 'py-3 px-2.5 rounded-2xl font-black text-base border-2 border-amber-400 bg-amber-500/20 text-amber-200 transition flex flex-col items-center shadow-[0_0_16px_rgba(250,204,21,0.22)]';
                } else {
                    btn.className = 'py-3 px-2.5 rounded-2xl font-black text-base border-2 border-slate-700 bg-slate-900/70 text-slate-400 transition flex flex-col items-center';
                }
            });
            document.getElementById('tableWarning').classList.toggle('hidden', selectedDivTables.length > 0);

            ['mixed', 'mcq', 'slate'].forEach(m => {
                const card = document.getElementById(`modeCard-${m}`);
                if (m === gameMode) {
                    card.className = 'p-3.5 rounded-2xl border-2 border-amber-400 bg-amber-500/20 text-left transition shadow-[0_0_16px_rgba(250,204,21,0.2)]';
                } else {
                    card.className = 'p-3.5 rounded-2xl border-2 border-slate-700 bg-slate-900/70 hover:border-slate-500 text-left transition';
                }
            });
        }

        /* =========================================================================
           4. THUẬT TOÁN SINH 20 CÂU HỎI BẢNG CHIA 2, 3, 4, 5 CHUẨN LỚP 2
              - Chặng 1 (Câu 1–6): Phép chia trực tiếp & Từ một phép nhân suy ra phép chia
              - Chặng 2 (Câu 7–12): Tên gọi Số bị chia - Số chia - Thương, Ô trống [?] & Đơn vị đo (kg, lít, cm, dm)
              - Chặng 3 (Câu 13–17): Bài toán Khoa học Tự nhiên, Văn hóa Việt & Xem đồng hồ Lớp 2
              - Chặng 4 (Câu 18–20): Đỉnh Chuông Vàng (Dãy tính 2 bước thực hiện lần lượt từ trái sang phải!)
           ========================================================================= */
        function createGrade2DivDistractors(correctAns, divisor = 2) {
            const set = new Set();
            // Nhiễu sư phạm dựa trên lỗi nhẩm lệch 1 bậc bảng nhân của học sinh Lớp 2
            const near = [
                correctAns - 1,
                correctAns + 1,
                correctAns + 2,
                correctAns - 2,
                divisor,
                correctAns + divisor
            ];
            for (const v of near) {
                if (v >= 1 && v !== correctAns) set.add(v);
                if (set.size === 3) break;
            }

            while (set.size < 3) {
                const delta = (Math.floor(Math.random() * 4) + 1) * (Math.random() > 0.5 ? 1 : -1);
                const cand = correctAns + delta;
                if (cand >= 1 && cand !== correctAns) set.add(cand);
            }

            const opts = [correctAns, ...Array.from(set)];
            for (let i = opts.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [opts[i], opts[j]] = [opts[j], opts[i]];
            }
            return opts;
        }

        function generateGrade2DivQuestion(stepNum, usedSet) {
            let d = selectedDivTables[Math.floor(Math.random() * selectedDivTables.length)];
            let q = 2;
            let key = '';
            let guard = 0;

            if (stepNum <= 6) {
                // CHẶNG 1: Khởi động phản xạ Bảng chia & Từ một phép nhân suy ra phép chia
                do {
                    d = selectedDivTables[Math.floor(Math.random() * selectedDivTables.length)];
                    q = stepNum <= 2 ? (Math.floor(Math.random() * 4) + 2) : (Math.floor(Math.random() * 9) + 2);
                    key = `g2d-c1-${d}-${q}`;
                    guard++;
                } while (usedSet.has(key) && guard < 35);
                usedSet.add(key);

                const dividend = d * q;

                if (stepNum === 5) {
                    // Trọng tâm SGK Toán 2: Từ phép nhân suy ra phép chia tương ứng
                    return {
                        stage: 'Chặng 1 • Từ Phép Nhân Suy Ra Phép Chia',
                        vi: `<span class="text-xl sm:text-3xl font-extrabold block">Biết <strong class="text-sky-300">${d} × ${q} = ${dividend}</strong>.<br>Vậy <strong class="text-amber-300 mt-1 inline-block">${dividend} : ${d} = ?</strong></span>`,
                        en: `🇬🇧 Inverse Link: Since ${d} × ${q} = ${dividend}, what is ${dividend} ÷ ${d}?`,
                        speech: `Since ${d} times ${q} equals ${dividend}, what is ${dividend} divided by ${d}?`,
                        answer: q,
                        unit: '',
                        options: createGrade2DivDistractors(q, d),
                        hint: `Lấy tích ${dividend} chia cho thừa số ${d} thì được ngay thừa số kia là ${q}!`,
                        explain: `Vì ${d} × ${q} = ${dividend} nên ${dividend} : ${d} = ${q}.`
                    };
                }

                return {
                    stage: 'Chặng 1 • Khởi Động Bảng Chia',
                    vi: `${dividend} : ${d} = <span class="text-amber-300">?</span>`,
                    en: `🇬🇧 Math English (${dividend} ÷ ${d}): What is ${dividend} divided by ${d}?`,
                    speech: `What is ${dividend} divided by ${d}?`,
                    answer: q,
                    unit: '',
                    options: createGrade2DivDistractors(q, d),
                    hint: `Em nhẩm ngược bảng nhân ${d}: ${d} nhân mấy thì bằng ${dividend}?`,
                    explain: `Vì ${d} × ${q} = ${dividend} nên ${dividend} : ${d} = ${q}.`
                };

            } else if (stepNum <= 12) {
                // CHẶNG 2: Thuật ngữ Số bị chia - Số chia - Thương, Ô trống [?] & Phép chia có đơn vị đo Lớp 2
                do {
                    d = selectedDivTables[Math.floor(Math.random() * selectedDivTables.length)];
                    q = Math.floor(Math.random() * 7) + 3; // 3..9
                    key = `g2d-c2-${stepNum % 3}-${d}-${q}`;
                    guard++;
                } while (usedSet.has(key) && guard < 35);
                usedSet.add(key);

                const dividend = d * q;
                const subType = stepNum % 3;

                if (subType === 1) {
                    // Khắc sâu tên gọi Số bị chia - Số chia - Thương
                    return {
                        stage: 'Chặng 2 • Số Bị Chia – Số Chia – Thương',
                        vi: `<span class="text-xl sm:text-3xl font-extrabold block">Biết <strong class="text-sky-300">Số bị chia</strong> là <strong class="text-amber-300">${dividend}</strong> và <strong class="text-sky-300">Số chia</strong> là <strong class="text-amber-300">${d}</strong>. Hỏi <strong class="text-emerald-300">Thương</strong> bằng bao nhiêu?</span>`,
                        en: `🇬🇧 Math Terms: The dividend is ${dividend} and the divisor is ${d}. What is the quotient?`,
                        speech: `The dividend is ${dividend} and the divisor is ${d}. What is the quotient?`,
                        answer: q,
                        unit: '',
                        options: createGrade2DivDistractors(q, d),
                        hint: `Muốn tìm Thương, em lấy Số bị chia chia cho Số chia: ${dividend} : ${d}!`,
                        explain: `Số bị chia là ${dividend}, Số chia là ${d}, nên Thương là: ${dividend} : ${d} = ${q}.`
                    };
                } else if (subType === 2) {
                    // Tìm số bí ẩn trong ô trống [?]
                    return {
                        stage: 'Chặng 2 • Tìm Số Bí Ẩn Trong Ô Trống',
                        vi: `${dividend} : <span class="px-3 py-0.5 rounded-xl bg-amber-400/20 border border-amber-300 text-amber-300">?</span> = ${q}`,
                        en: `🇬🇧 Mystery Number: ${dividend} divided by what number equals ${q}?`,
                        speech: `${dividend} divided by what number equals ${q}?`,
                        answer: d,
                        unit: '',
                        options: createGrade2DivDistractors(d, q),
                        hint: `Trong bảng chia nào mà ${dividend} chia cho số đó được ${q}? (Nhẩm: mấy nhân ${q} bằng ${dividend}?)`,
                        explain: `Vì ${dividend} : ${d} = ${q} (do ${d} × ${q} = ${dividend}) nên số cần điền là ${d}.`
                    };
                } else {
                    // Phép chia kèm đơn vị đo đại lượng Lớp 2 (kg, lít, cm, dm)
                    const units = [
                        { u: 'kg', en: 'kilograms' },
                        { u: 'lít', en: 'liters' },
                        { u: 'cm', en: 'centimeters' },
                        { u: 'dm', en: 'decimeters' }
                    ];
                    const picked = units[stepNum % units.length];
                    return {
                        stage: 'Chặng 2 • Phép Chia Có Đơn Vị Đo',
                        vi: `${dividend} ${picked.u} : ${d} = <span class="text-amber-300">? ${picked.u}</span>`,
                        en: `🇬🇧 Measurement Math: What is ${dividend} ${picked.en} divided by ${d}?`,
                        speech: `What is ${dividend} ${picked.en} divided by ${d}?`,
                        answer: q,
                        unit: picked.u,
                        options: createGrade2DivDistractors(q, d),
                        hint: `Em nhẩm phép chia ${dividend} : ${d} như bình thường rồi giữ nguyên đơn vị ${picked.u} nhé!`,
                        explain: `Ta có ${dividend} ${picked.u} : ${d} = ${q} ${picked.u}.`
                    };
                }

            } else if (stepNum <= 17) {
                // CHẶNG 3: Bài toán Khoa học Tự nhiên, Văn hóa Việt Nam & Xem đồng hồ Lớp 2
                do {
                    d = selectedDivTables[Math.floor(Math.random() * selectedDivTables.length)];
                    q = Math.floor(Math.random() * 6) + 4; // 4..9
                    key = `g2d-story-${d}-${q}-${stepNum % 2}`;
                    guard++;
                } while (usedSet.has(key) && guard < 35);
                usedSet.add(key);

                // Câu 16 đặc biệt nếu có chọn Bảng chia 5: Ứng dụng Bảng chia 5 để tìm vị trí kim phút trên mặt đồng hồ!
                if (stepNum === 16 && selectedDivTables.includes(5)) {
                    const targetNum = 7; // 35 phút : 5 = chỉ đúng vào số 7
                    const totalMins = 5 * targetNum;
                    return {
                        stage: 'Chặng 3 • Ứng Dụng Xem Đồng Hồ Lớp 2',
                        vi: `<span class="text-lg sm:text-2xl font-extrabold leading-relaxed block">Trên mặt đồng hồ, mỗi khoảng từ số này sang số tiếp theo là <strong>5 phút</strong>. Khi đồng hồ chỉ <strong>8 giờ ${totalMins} phút</strong>, đố bé kim phút đang chỉ đúng vào số mấy?</span>`,
                        en: `🇬🇧 Clock Math: Each number step is 5 minutes. Divide ${totalMins} minutes by 5 to find the number!`,
                        speech: `Each number step on the clock is 5 minutes. What is ${totalMins} divided by 5?`,
                        answer: targetNum,
                        unit: '',
                        options: createGrade2DivDistractors(targetNum, 5),
                        hint: `Mỗi số cách nhau 5 phút, em lấy ${totalMins} : 5 là biết ngay kim phút chỉ vào số mấy!`,
                        explain: `Ta lấy ${totalMins} : 5 = ${targetNum}. Vậy kim phút chỉ đúng vào số ${targetNum}!`
                    };
                }

                const dividend = d * q;
                const templates = GRADE2_DIVISION_STORIES[d];
                const tpl = templates[stepNum % templates.length];

                return {
                    stage: 'Chặng 3 • Thiên Nhiên & Văn Hóa Việt Nam',
                    vi: `<span class="text-lg sm:text-2xl font-extrabold leading-relaxed block">${tpl.vi(dividend)}</span>`,
                    en: tpl.en(dividend),
                    speech: tpl.speech(dividend),
                    answer: q,
                    unit: '',
                    options: createGrade2DivDistractors(q, d),
                    hint: `Có tất cả ${dividend}, chia đều theo ${d}. Bé thực hiện phép chia ${dividend} : ${d} nhé!`,
                    explain: `Phép tính đúng là: ${dividend} : ${d} = ${q}.`
                };

            } else {
                // CHẶNG 4 (Câu 18–20): Đỉnh Chuông Vàng Lớp 2 (Dãy tính 2 bước thực hiện LẦN LƯỢT TỪ TRÁI SANG PHẢI!)
                d = selectedDivTables[Math.floor(Math.random() * selectedDivTables.length)];
                q = Math.floor(Math.random() * 5) + 5; // 5..9
                const dividend = d * q;

                const isPlus = (stepNum !== 19);
                const extra = stepNum === 20 ? 14 : (isPlus ? 11 : 3);
                const ans = isPlus ? (q + extra) : (q - extra);

                return {
                    stage: stepNum === 20 ? '🔔 CÂU HỎI QUYẾT ĐỊNH RUNG CHUÔNG VÀNG' : 'Chặng Cuối • Đỉnh Cao Chuông Vàng',
                    vi: `${stepNum === 20 ? '🔔 ' : ''}Tính kết quả dãy tính (tính từ trái sang phải):<br><span class="text-amber-300 mt-1 inline-block">${dividend} : ${d} ${isPlus ? '+' : '-'} ${extra} = ?</span>`,
                    en: `🇬🇧 Golden Bell Challenge: Calculate (${dividend} ÷ ${d}) ${isPlus ? 'plus' : 'minus'} ${extra}.`,
                    speech: `Golden Bell Challenge! Calculate ${dividend} divided by ${d}, ${isPlus ? 'plus' : 'minus'} ${extra}.`,
                    answer: ans,
                    unit: '',
                    options: createGrade2DivDistractors(ans, d),
                    hint: `Bé tính lần lượt từ trái sang phải nhé: Bước 1 tính ${dividend} : ${d} = ${q}, Bước 2 lấy ${q} ${isPlus ? '+' : '-'} ${extra}!`,
                    explain: `Bước 1: ${dividend} : ${d} = ${q}. Bước 2: ${q} ${isPlus ? '+' : '-'} ${extra} = ${ans}.`
                };
            }
        }

        function buildArenaQuestionDeck() {
            questionDeck = [];
            const usedSet = new Set();
            for (let s = 1; s <= TOTAL_STEPS; s++) {
                questionDeck.push(generateGrade2DivQuestion(s, usedSet));
            }
        }

        /* =========================================================================
           5. ĐIỀU PHỐI LUỒNG CHƠI TRÊN SÀN ĐẤU & BẢNG CON HỌC SINH LỚP 2
           ========================================================================= */
        function startGoldenBellArena() {
            if (selectedDivTables.length === 0) {
                document.getElementById('tableWarning').classList.remove('hidden');
                playWrongShowSound();
                return;
            }
            ensureAudio();
            stopArenaBGM();
            stopConfetti();
            ringGoldenBellAudio(true, false);
            playOpeningFanfare();

            const rawName = document.getElementById('playerNameInput').value.trim();
            document.getElementById('arenaPlayerName').textContent = rawName || 'Bé Thông Thái 2A';

            stepIndex = 0;
            score = 0;
            streak = 0;
            maxStreak = 0;
            lifelines = { plane: true, extraTime: true, swap: true, stageShield: true };
            syncLifelineButtons();
            buildArenaQuestionDeck();

            document.getElementById('lobbyScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('arenaScreen').classList.remove('hidden');
            document.getElementById('homeBtn').classList.remove('hidden');

            loadStepQuestion();
        }

        function returnToLobby() {
            clearInterval(timerInterval);
            stopArenaBGM();
            stopConfetti();
            playClickPop(500);

            document.getElementById('arenaScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('homeBtn').classList.add('hidden');
            document.getElementById('lobbyScreen').classList.remove('hidden');
        }

        function renderLadderSteps() {
            const box = document.getElementById('ladderGrid');
            let html = '';
            for (let i = 0; i < TOTAL_STEPS; i++) {
                const num = i + 1;
                let cls = 'bg-slate-900 text-slate-400 border-slate-700';
                if (i < stepIndex) {
                    cls = 'bg-emerald-500 text-slate-950 border-emerald-300 font-black';
                } else if (i === stepIndex) {
                    cls = 'bg-amber-400 text-slate-950 border-white font-black scale-110 shadow-[0_0_12px_rgba(250,204,21,0.85)] z-10';
                } else if (num === 20) {
                    cls = 'bg-amber-950/80 text-amber-300 border-amber-500/60 font-black';
                }
                html += `<div class="h-7 rounded-lg border text-xs flex items-center justify-center transition-all ${cls}">${num === 20 ? '🔔' : num}</div>`;
            }
            box.innerHTML = html;
        }

        function shouldUseSlateKeypad(idx) {
            if (gameMode === 'mcq') return false;
            if (gameMode === 'slate') return true;
            return idx >= 14; // Câu 15 -> 20 tự viết số lên bảng con
        }

        function syncLifelineButtons() {
            document.getElementById('btnPlaneHelp').disabled = !lifelines.plane;
            document.getElementById('btnTimeHelp').disabled = !lifelines.extraTime;
            document.getElementById('btnSwapHelp').disabled = !lifelines.swap;

            const shieldEl = document.getElementById('stageShieldBadge');
            if (lifelines.stageShield) {
                shieldEl.textContent = 'Còn 1 lần';
                shieldEl.className = 'font-black text-emerald-400';
            } else {
                shieldEl.textContent = 'Đã dùng';
                shieldEl.className = 'font-bold text-slate-500';
            }
        }

        function loadStepQuestion() {
            canAnswer = true;
            slateInputStr = '';
            const slateTextEl = document.getElementById('slateValueText');
            slateTextEl.textContent = '?';
            slateTextEl.className = 'text-3xl font-black text-amber-300 tracking-widest min-h-[36px] inline-block';
            document.getElementById('hintBannerBox').classList.add('hidden');

            const q = questionDeck[stepIndex];
            const stepNum = stepIndex + 1;

            document.getElementById('currentStepText').textContent = stepNum;
            document.getElementById('scoreCount').textContent = score;
            document.getElementById('streakCount').textContent = streak;
            document.getElementById('stageBadgeLabel').textContent = q.stage;
            document.getElementById('tableScopeTag').textContent = `Bảng chia: ${selectedDivTables.join(', ')}`;
            document.getElementById('slateUnitSuffix').textContent = q.unit ? q.unit : '';

            document.getElementById('questionMainVi').innerHTML = q.vi;
            const enEl = document.getElementById('questionMainEn');
            enEl.textContent = q.en;
            enEl.classList.toggle('hidden', !bilingualActive);

            renderLadderSteps();

            const useKeypad = shouldUseSlateKeypad(stepIndex);
            const mcqBox = document.getElementById('mcqOptionsGrid');
            const slateBox = document.getElementById('slateKeypadArea');
            const tag = document.getElementById('inputMethodTag');

            if (useKeypad) {
                mcqBox.classList.add('hidden');
                slateBox.classList.remove('hidden');
                tag.innerHTML = `<i class="fa-solid fa-chalkboard text-emerald-300 mr-1"></i>Tự viết thương lên Bảng con`;
            } else {
                slateBox.classList.add('hidden');
                mcqBox.classList.remove('hidden');
                tag.innerHTML = `<i class="fa-solid fa-hand-pointer text-amber-300 mr-1"></i>Chọn nhanh đáp án đúng`;

                const letters = ['A', 'B', 'C', 'D'];
                mcqBox.innerHTML = q.options.map((val, idx) => {
                    const disp = q.unit ? `${val} ${q.unit}` : `${val}`;
                    return `
                        <button id="optBtn-${idx}" onclick="selectMcqOption(${val}, ${idx})"
                            class="btn-option py-4 px-3 rounded-2xl text-white font-black text-xl sm:text-2xl flex items-center justify-center gap-2.5">
                            <span class="w-7 h-7 rounded-lg bg-amber-400/20 border border-amber-400/50 text-amber-300 text-xs flex items-center justify-center font-extrabold">${letters[idx]}</span>
                            <span>${disp}</span>
                        </button>
                    `;
                }).join('');
            }

            // Thời gian rộng rãi cho học sinh Lớp 2 đọc đề thoải mái: Câu ngắn 22s, câu lời văn & dãy tính 30s
            maxTime = stepNum >= 13 ? 30 : 22;
            startStepTimer(maxTime);

            setTimeout(() => {
                if (canAnswer && !document.getElementById('arenaScreen').classList.contains('hidden')) {
                    startArenaBGM();
                }
            }, stepIndex === 0 ? 950 : 250);
        }

        function startStepTimer(seconds) {
            clearInterval(timerInterval);
            timeLeft = seconds;
            updateTimerVisual();

            timerInterval = setInterval(() => {
                if (!canAnswer) return;
                timeLeft--;
                updateTimerVisual();

                if (timeLeft <= 5 && timeLeft > 0) playFinalSecondsBeep(true);
                else if (timeLeft > 5) playFinalSecondsBeep(false);

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    playTimeUpGong();
                    handleWrongOrTimeout(true);
                }
            }, 1000);
        }

        function updateTimerVisual() {
            const numEl = document.getElementById('timerNumber');
            const circle = document.getElementById('timerCircle');
            numEl.textContent = timeLeft;

            const circum = 264;
            const ratio = Math.max(0, timeLeft / maxTime);
            circle.style.strokeDashoffset = circum * (1 - ratio);

            if (timeLeft <= 5) {
                circle.setAttribute('stroke', '#ef4444');
                numEl.className = 'text-2xl sm:text-3xl font-black text-rose-400 animate-pulse';
            } else if (timeLeft <= 10) {
                circle.setAttribute('stroke', '#f59e0b');
                numEl.className = 'text-2xl sm:text-3xl font-black text-amber-300';
            } else {
                circle.setAttribute('stroke', '#22c55e');
                numEl.className = 'text-2xl sm:text-3xl font-black text-white';
            }
        }

        /* =========================================================================
           6. XỬ LÝ CHẤM ĐÁP ÁN & BÀN PHÍM BẢNG CON
           ========================================================================= */
        function selectMcqOption(chosenVal, btnIdx) {
            if (!canAnswer) return;
            canAnswer = false;
            clearInterval(timerInterval);

            const q = questionDeck[stepIndex];
            const btn = document.getElementById(`optBtn-${btnIdx}`);

            if (chosenVal === q.answer) {
                if (btn) btn.classList.add('correct');
                handleCorrectStep();
            } else {
                if (btn) btn.classList.add('wrong');
                q.options.forEach((opt, idx) => {
                    if (opt === q.answer) {
                        const rightBtn = document.getElementById(`optBtn-${idx}`);
                        if (rightBtn) rightBtn.classList.add('correct');
                    }
                });
                handleWrongOrTimeout(false);
            }
        }

        function typeDigit(d) {
            if (!canAnswer) return;
            playClickPop(640);
            if (slateInputStr.length < 3) {
                slateInputStr += d;
                document.getElementById('slateValueText').textContent = slateInputStr;
            }
        }

        function clearSlateDigits() {
            if (!canAnswer) return;
            playClickPop(480);
            slateInputStr = '';
            document.getElementById('slateValueText').textContent = '?';
        }

        function submitSlateNumber() {
            if (!canAnswer || slateInputStr === '') return;
            canAnswer = false;
            clearInterval(timerInterval);

            const val = parseInt(slateInputStr, 10);
            const q = questionDeck[stepIndex];
            const slateEl = document.getElementById('slateValueText');

            if (val === q.answer) {
                slateEl.className = 'text-3xl font-black text-emerald-400 tracking-widest min-h-[36px] inline-block';
                handleCorrectStep();
            } else {
                slateEl.className = 'text-3xl font-black text-rose-400 tracking-widest min-h-[36px] inline-block';
                const hintBox = document.getElementById('hintBannerBox');
                const dispRight = q.unit ? `${q.answer} ${q.unit}` : `${q.answer}`;
                hintBox.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i>Đáp án đúng trên bảng con là: <strong class="text-white text-base">${dispRight}</strong> (${q.explain})`;
                hintBox.classList.remove('hidden');
                handleWrongOrTimeout(false);
            }
        }

        // Hỗ trợ nhập bằng bàn phím máy tính trên lớp học
        window.addEventListener('keydown', (e) => {
            if (document.getElementById('arenaScreen').classList.contains('hidden') || !canAnswer) return;
            if (shouldUseSlateKeypad(stepIndex)) {
                if (e.key >= '0' && e.key <= '9') typeDigit(e.key);
                else if (e.key === 'Backspace' || e.key === 'Delete') clearSlateDigits();
                else if (e.key === 'Enter') submitSlateNumber();
            }
        });

        function handleCorrectStep() {
            const isFinalQuestion = (stepIndex === TOTAL_STEPS - 1);
            if (isFinalQuestion) {
                ringGoldenBellAudio(true, false);
            } else {
                playCorrectShowSound();
            }

            streak++;
            if (streak > maxStreak) maxStreak = streak;
            score += 10 + Math.min(streak * 2, 10);

            document.getElementById('scoreCount').textContent = score;
            document.getElementById('streakCount').textContent = streak;

            const quote = PRAISE_QUOTES[Math.floor(Math.random() * PRAISE_QUOTES.length)];
            document.getElementById('teacherMsgVi').textContent = quote.vi;
            document.getElementById('teacherMsgEn').textContent = `"${quote.en}"`;

            setTimeout(() => {
                stepIndex++;
                if (stepIndex >= TOTAL_STEPS) {
                    finishArenaGame(true, null);
                } else {
                    loadStepQuestion();
                }
            }, 1200);
        }

        function handleWrongOrTimeout(isTimeout) {
            if (!isTimeout) {
                playWrongShowSound();
            } else {
                setTimeout(() => playWrongShowSound(), 320);
            }

            streak = 0;
            document.getElementById('streakCount').textContent = 0;

            const q = questionDeck[stepIndex];
            const prefix = isTimeout ? '⏰ Hết thời gian giơ bảng!' : '❌ Kết quả chưa chính xác rồi!';
            document.getElementById('teacherMsgVi').textContent = `${prefix} ${q.explain}`;
            document.getElementById('teacherMsgEn').textContent = `"Don't give up! Let's check the multiplication table!"`;

            // Nếu còn Phao Cứu Trợ Sân Đấu (và chưa phải câu 20 cuối cùng), thầy cô tung cứu trợ 1 lần!
            if (lifelines.stageShield && stepIndex < TOTAL_STEPS - 1) {
                setTimeout(() => {
                    document.getElementById('stageRescueExplain').innerHTML =
                        `<div class="font-black text-rose-300 mb-1">${prefix}</div>
                         <div class="font-bold text-amber-300 mb-1">${q.explain}</div>
                         <div class="text-slate-300 text-xs">${q.hint}</div>`;
                    document.getElementById('stageRescueModal').classList.remove('hidden');
                }, 950);
            } else {
                setTimeout(() => {
                    finishArenaGame(false, q);
                }, 1550);
            }
        }

        function acceptStageRescue() {
            lifelines.stageShield = false;
            syncLifelineButtons();
            document.getElementById('stageRescueModal').classList.add('hidden');

            triggerPaperPlaneAnimation();
            playPaperPlaneSound();

            stepIndex++;
            loadStepQuestion();
        }

        function speakCurrentMathEnglish() {
            const q = questionDeck[stepIndex];
            if (!q) return;
            speakEnglish(q.speech);
        }

        /* =========================================================================
           7. BA QUYỀN CỨU TRỢ CHỦ ĐỘNG TRÊN BẢNG CON
           ========================================================================= */
        function triggerPaperPlaneAnimation() {
            const overlay = document.getElementById('paperPlaneOverlay');
            const badge = document.getElementById('paperPlaneBadge');
            overlay.classList.remove('hidden');
            badge.classList.remove('plane-anim');
            void badge.offsetWidth;
            badge.classList.add('plane-anim');
            setTimeout(() => overlay.classList.add('hidden'), 1850);
        }

        // 1. Máy bay giấy Thầy Cô: Hiện gợi ý nhẩm ngược bảng nhân & loại 2 phương án sai
        function usePaperPlaneLifeline() {
            if (!canAnswer || !lifelines.plane) return;
            lifelines.plane = false;
            syncLifelineButtons();
            playPaperPlaneSound();
            triggerPaperPlaneAnimation();

            const q = questionDeck[stepIndex];
            const box = document.getElementById('hintBannerBox');
            box.innerHTML = `<i class="fa-solid fa-paper-plane text-sky-300 mr-1.5"></i><strong>Thư từ Máy Bay Giấy Thầy Cô:</strong> ${q.hint}`;
            box.classList.remove('hidden');

            if (!shouldUseSlateKeypad(stepIndex)) {
                let hiddenCount = 0;
                q.options.forEach((opt, idx) => {
                    if (opt !== q.answer && hiddenCount < 2) {
                        const b = document.getElementById(`optBtn-${idx}`);
                        if (b) {
                            b.disabled = true;
                            b.classList.add('opacity-20', 'line-through');
                            hiddenCount++;
                        }
                    }
                });
            }
        }

        // 2. Cộng thêm 15 giây suy nghĩ
        function useExtraTimeLifeline() {
            if (!canAnswer || !lifelines.extraTime) return;
            lifelines.extraTime = false;
            syncLifelineButtons();
            playCorrectShowSound();
            if (studioBgmOn) startArenaBGM();

            timeLeft += 15;
            maxTime = Math.max(maxTime, timeLeft);
            updateTimerVisual();

            document.getElementById('teacherMsgVi').textContent = '⏳ Đã cộng thêm 15 giây! Bé cứ bình tĩnh nhẩm bảng nhân tương ứng nhé!';
            document.getElementById('teacherMsgEn').textContent = '"Plus 15 extra seconds! Take your time!"';
        }

        // 3. Đổi câu hỏi khác cùng cấp độ
        function useSwapQuestionLifeline() {
            if (!canAnswer || !lifelines.swap) return;
            lifelines.swap = false;
            syncLifelineButtons();
            playClickPop(740);

            questionDeck[stepIndex] = generateGrade2DivQuestion(stepIndex + 1, new Set());
            loadStepQuestion();
        }

        /* =========================================================================
           8. VINH DANH RUNG CHUÔNG VÀNG & HIỆU ỨNG PHÁO HOA
           ========================================================================= */
        function finishArenaGame(isChampion, failedQuestion) {
            clearInterval(timerInterval);
            stopArenaBGM();

            document.getElementById('arenaScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.remove('hidden');

            const player = document.getElementById('arenaPlayerName').textContent;
            const grandBell = document.getElementById('grandBellSvg');

            document.getElementById('finalStepStat').textContent = `${isChampion ? TOTAL_STEPS : stepIndex}/${TOTAL_STEPS}`;
            document.getElementById('finalScoreStat').textContent = score;
            document.getElementById('finalStreakStat').textContent = maxStreak;

            const tag = document.getElementById('resultLaurelTag');
            const title = document.getElementById('resultMainTitle');
            const sub = document.getElementById('resultSubTitle');
            const revCard = document.getElementById('reviewNoteCard');
            const revText = document.getElementById('reviewNoteText');

            if (isChampion) {
                playOpeningFanfare();
                ringGoldenBellAudio(false, true);
                setTimeout(() => ringGoldenBellAudio(false, true), 1150);
                startConfetti();

                tag.textContent = '👑 VÒNG NGUYỆT QUẾ RUNG CHUÔNG VÀNG LỚP 2';
                title.textContent = `HOAN HÔ! ${player.toUpperCase()} ĐÃ RUNG CHUÔNG VÀNG!`;
                sub.innerHTML = `Em đã chinh phục trọn vẹn cả <strong>20/20 câu hỏi</strong> Bảng chia ${selectedDivTables.join(', ')}! Chạm vào chiếc Chuông Vàng để ngân vang chiến thắng nhé! <em>(Congratulations, Grade 2 Division Champion!)</em>`;
                revCard.classList.add('hidden');
                speakEnglish('Congratulations! You have mastered the division tables and rung the Golden Bell!');
            } else {
                grandBell.classList.remove('bell-ringing');
                tag.textContent = '🌟 CHIẾN BINH NHÍ ĐÁNG KHEN NGỢI';
                title.textContent = `Cố Gắng Rất Giỏi, ${player}!`;
                sub.innerHTML = `Em đã vượt qua <strong>${stepIndex}/20</strong> nấc thang Rung Chuông Vàng. Cùng xem lại lời dặn bên dưới để lượt sau chạm đỉnh Chuông Vàng nhé!`;

                if (failedQuestion) {
                    revCard.classList.remove('hidden');
                    revText.innerHTML = `<strong>Ở câu vừa rồi:</strong> ${failedQuestion.explain}<br><span class="text-amber-200">${failedQuestion.hint}</span>`;
                }
            }
        }

        let confettiAnimId = null;
        let confettiList = [];

        function resizeConfettiCanvas() {
            const c = document.getElementById('confettiCanvas');
            c.width = window.innerWidth;
            c.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeConfettiCanvas);

        function startConfetti() {
            resizeConfettiCanvas();
            const c = document.getElementById('confettiCanvas');
            const ctx = c.getContext('2d');
            const colors = ['#fde047', '#f59e0b', '#2dd4bf', '#38bdf8', '#fb7185', '#ffffff'];

            confettiList = Array.from({ length: 130 }, () => ({
                x: Math.random() * c.width,
                y: Math.random() * c.height - c.height,
                w: Math.random() * 10 + 5,
                h: Math.random() * 6 + 4,
                color: colors[Math.floor(Math.random() * colors.length)],
                vy: Math.random() * 3.2 + 2,
                vx: (Math.random() - 0.5) * 2.2,
                rot: Math.random() * Math.PI * 2,
                vRot: (Math.random() - 0.5) * 0.14
            }));

            function render() {
                ctx.clearRect(0, 0, c.width, c.height);
                confettiList.forEach(p => {
                    p.y += p.vy;
                    p.x += p.vx;
                    p.rot += p.vRot;
                    if (p.y > c.height + 20) {
                        p.y = -15;
                        p.x = Math.random() * c.width;
                    }
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.rot);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
                    ctx.restore();
                });
                confettiAnimId = requestAnimationFrame(render);
            }
            cancelAnimationFrame(confettiAnimId);
            render();
        }

        function stopConfetti() {
            cancelAnimationFrame(confettiAnimId);
            const c = document.getElementById('confettiCanvas');
            const ctx = c.getContext('2d');
            if (ctx) ctx.clearRect(0, 0, c.width, c.height);
        }

        window.onload = function () {
            resizeConfettiCanvas();
            refreshLobbySelections();
        };
    </script>
