        // Tiếng vỗ tay khán giả trường quay tổng hợp tự nhiên
        function playStudioApplause(duration = 1.3, peak = 0.11) {
            if (!soundEnabled || !audioCtx || !noiseBuffer) return;
            const now = audioCtx.currentTime;
            const claps = Math.floor(duration * 16);
            for (let i = 0; i < claps; i++) {
                const src = audioCtx.createBufferSource();
                src.buffer = noiseBuffer;
                const bp = audioCtx.createBiquadFilter();
                bp.type = 'bandpass';
                bp.frequency.value = 1100 + Math.random() * 1400;
                bp.Q.value = 1.4;

                const g = audioCtx.createGain();
                const t = now + (i / claps) * duration + Math.random() * 0.03;
                const amp = peak * (1 - (i / claps) * 0.55);
                g.gain.setValueAtTime(0.0005, t);
                g.gain.linearRampToValueAtTime(amp, t + 0.012);
                g.gain.exponentialRampToValueAtTime(0.0005, t + 0.085);

                src.connect(bp);
                bp.connect(g);
                g.connect(masterBus);
                src.start(t, Math.random() * 0.8, 0.1);
            }
        }

        // Nhạc hiệu Kèn đồng Khai cuộc Sàn Thi Đấu Rung Chuông Vàng
        function playOpeningFanfare() {
            if (!soundEnabled) return;
            ensureAudio();
            if (!audioCtx) return;
            const now = audioCtx.currentTime;

            const brassNotes = [
                { m: 62, t: 0.00, d: 0.14 },
                { m: 66, t: 0.14, d: 0.14 },
                { m: 69, t: 0.28, d: 0.14 },
                { m: 74, t: 0.42, d: 0.30 },
                { m: 69, t: 0.74, d: 0.16 },
                { m: 74, t: 0.92, d: 0.62 }
            ];
            brassNotes.forEach(n => {
                [0, -12].forEach((oct, idx) => {
                    const osc = audioCtx.createOscillator();
                    const flt = audioCtx.createBiquadFilter();
                    const g = audioCtx.createGain();
                    const s = now + n.t;

                    osc.type = idx === 0 ? 'sawtooth' : 'triangle';
                    osc.frequency.setValueAtTime(midiToHz(n.m + oct), s);
                    flt.type = 'lowpass';
                    flt.frequency.setValueAtTime(3100, s);
                    flt.frequency.exponentialRampToValueAtTime(1100, s + n.d);

                    g.gain.setValueAtTime(0.001, s);
                    g.gain.linearRampToValueAtTime(idx === 0 ? 0.13 : 0.085, s + 0.02);
                    g.gain.exponentialRampToValueAtTime(0.001, s + n.d + 0.04);

                    osc.connect(flt);
                    flt.connect(g);
                    g.connect(masterBus);
                    g.connect(hallEchoBus);
                    osc.start(s);
                    osc.stop(s + n.d + 0.05);
                });
            });
            playStudioApplause(1.2, 0.09);
        }

        // Nhạc nền đếm ngược sôi động kiểu Gameshow TV (tự động đẩy cao trào khi còn <= 5 giây)
        function stopArenaBGM() {
