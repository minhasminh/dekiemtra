<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rung Chuông Vàng Nhí - Bảng Chia 2, 3, 4, 5 (Toán Lớp 2)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Nunito nét tròn trịa, hiển thị dấu Tiếng Việt rõ ràng chuẩn Tiểu học Lớp 2 -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,600;0,700;0,800;0,900;1,700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --gold-bright: #fde047;
            --gold-main: #eab308;
            --slate-board: #0b2942;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: radial-gradient(circle at 50% 0%, #0f3d5e 0%, #0f172a 58%, #020617 100%);
            color: #f8fafc;
            min-height: 100vh;
            overflow-x: hidden;
            user-select: none;
        }

        /* Ánh đèn sân khấu Rung Chuông Vàng */
        .stage-spotlight {
            position: fixed;
            top: -20%;
            width: 48vw;
            height: 85vh;
            pointer-events: none;
            z-index: 0;
            opacity: 0.24;
            filter: blur(50px);
        }
        .beam-left {
            left: -10%;
            background: conic-gradient(from 140deg at 50% 0%, #facc15, transparent 62%);
            animation: swayBeamLeft 7.5s ease-in-out infinite alternate;
        }
        .beam-right {
            right: -10%;
            background: conic-gradient(from 200deg at 50% 0%, #2dd4bf, transparent 62%);
            animation: swayBeamRight 7.5s ease-in-out infinite alternate;
        }

        @keyframes swayBeamLeft {
            0% { transform: rotate(-8deg); }
            100% { transform: rotate(12deg); }
        }
        @keyframes swayBeamRight {
            0% { transform: rotate(8deg); }
            100% { transform: rotate(-12deg); }
        }

        /* Chuyển động lắc Chuông Vàng */
        @keyframes ringGoldenBell {
            0% { transform: rotate(0deg); }
            15% { transform: rotate(22deg); }
            30% { transform: rotate(-20deg); }
            45% { transform: rotate(15deg); }
            60% { transform: rotate(-12deg); }
            75% { transform: rotate(7deg); }
            90% { transform: rotate(-4deg); }
            100% { transform: rotate(0deg); }
        }
        .bell-ringing {
            animation: ringGoldenBell 1.2s ease-in-out infinite;
            transform-origin: top center;
        }
        .bell-hover:hover {
            animation: ringGoldenBell 1s ease-in-out;
            transform-origin: top center;
        }

        /* Khung Bảng Con Học Sinh Tiểu Học Việt Nam */
        .student-slate {
            background: linear-gradient(155deg, #0d2e47 0%, #071929 100%);
            border: 8px solid #38bdf8;
            box-shadow:
                0 18px 40px rgba(0, 0, 0, 0.55),
                inset 0 0 28px rgba(56, 189, 248, 0.16),
                0 0 0 3px #0284c7;
            position: relative;
        }

        /* Ô ly mờ trên mặt bảng con */
        .slate-grid {
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 28px 28px;
        }

        /* Nút Vàng Sân Khấu nổi 3D */
        .btn-gold-3d {
            background: linear-gradient(180deg, #fde047 0%, #eab308 56%, #ca8a04 100%);
            color: #3b1806;
            box-shadow: 0 6px 0 #854d0e, 0 10px 22px rgba(234, 179, 8, 0.38);
            transition: all 0.15s ease;
        }
        .btn-gold-3d:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #854d0e, 0 14px 26px rgba(234, 179, 8, 0.52);
        }
        .btn-gold-3d:active:not(:disabled) {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #854d0e;
        }

        /* Nút Đáp Án trên Bảng Con */
        .btn-option {
            background: linear-gradient(180deg, #16304a 0%, #0c1d2e 100%);
            border: 2px solid #335c81;
            box-shadow: 0 5px 0 #040d17;
            transition: all 0.15s ease;
        }
        .btn-option:hover:not(:disabled) {
            border-color: #fde047;
            background: linear-gradient(180deg, #1e4266 0%, #102a45 100%);
            transform: translateY(-2px);
            box-shadow: 0 7px 0 #040d17, 0 0 16px rgba(250, 204, 21, 0.28);
        }
        .btn-option:active:not(:disabled) {
            transform: translateY(3px);
            box-shadow: 0 2px 0 #040d17;
        }
        .btn-option.correct {
            background: linear-gradient(180deg, #22c55e 0%, #15803d 100%) !important;
            border-color: #bbf7d0 !important;
            color: #ffffff !important;
            box-shadow: 0 5px 0 #14532d, 0 0 25px rgba(34, 197, 94, 0.65) !important;
        }
        .btn-option.wrong {
            background: linear-gradient(180deg, #ef4444 0%, #b91c1c 100%) !important;
            border-color: #fecaca !important;
            color: #ffffff !important;
            box-shadow: 0 5px 0 #7f1d1d !important;
        }

        /* Hiệu ứng Máy bay giấy cứu trợ bay ngang sân thi đấu */
        @keyframes flyPaperPlane {
            0% { transform: translate(-115vw, 35vh) rotate(14deg) scale(0.65); opacity: 0; }
            18% { opacity: 1; }
            50% { transform: translate(0vw, -4vh) rotate(-4deg) scale(1.2); opacity: 1; }
            100% { transform: translate(115vw, -42vh) rotate(-18deg) scale(0.8); opacity: 0; }
        }
        .plane-anim {
            animation: flyPaperPlane 1.85s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
        }

        /* Sóng nhạc Equalizer Trường quay TV */
        @keyframes tvEqBounce {
            0%, 100% { transform: scaleY(0.28); }
            50% { transform: scaleY(1); }
        }
        .tv-eq-bar {
            width: 3px;
            height: 12px;
            background: #fde047;
            border-radius: 2px;
            transform-origin: bottom;
            animation: tvEqBounce 0.55s ease-in-out infinite;
        }
        .tv-eq-paused .tv-eq-bar {
            animation-play-state: paused;
            transform: scaleY(0.25);
            opacity: 0.4;
        }

        #confettiCanvas {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 60;
        }
    </style>
</head>
<body class="relative flex flex-col items-center justify-between p-2.5 sm:p-5">

    <!-- Ánh sáng sân khấu & Pháo hoa -->
    <div class="stage-spotlight beam-left"></div>
    <div class="stage-spotlight beam-right"></div>
    <canvas id="confettiCanvas"></canvas>

    <!-- Máy bay giấy cứu trợ bay ngang màn hình -->
    <div id="paperPlaneOverlay" class="fixed inset-0 pointer-events-none z-50 hidden flex items-center justify-center">
        <div id="paperPlaneBadge" class="flex items-center gap-3 bg-amber-400 text-slate-950 font-black px-6 py-3 rounded-full shadow-2xl border-4 border-white">
            <i class="fa-solid fa-paper-plane text-2xl sm:text-3xl text-blue-700"></i>
            <span class="text-base sm:text-xl">Máy Bay Giấy Cứu Trợ Thầy Cô Đã Tới!</span>
        </div>
    </div>

    <!-- ================= THANH ĐIỀU HƯỚNG TRƯỜNG QUAY ================= -->
    <header class="relative z-10 w-full max-w-6xl flex flex-wrap items-center justify-between gap-2.5 bg-slate-950/85 backdrop-blur-md border border-sky-500/35 rounded-2xl px-4 py-2.5 shadow-2xl">
        <div class="flex items-center gap-3">
            <!-- Chuông Vàng SVG tương tác -->
            <div id="headerBell" onclick="ringGoldenBellAudio(true, false)" class="w-11 h-11 flex items-center justify-center bell-hover cursor-pointer" title="Nhấn để nghe tiếng Chuông Vàng ngân vang!">
                <svg viewBox="0 0 64 64" class="w-10 h-10 drop-shadow-[0_0_10px_rgba(250,204,21,0.85)]">
                    <defs>
                        <linearGradient id="goldBellGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#fef08a"/>
                            <stop offset="45%" stop-color="#facc15"/>
                            <stop offset="100%" stop-color="#b45309"/>
                        </linearGradient>
                    </defs>
                    <circle cx="32" cy="9" r="5" fill="#fde047"/>
                    <path d="M19 48 C19 25, 22 13, 32 13 C42 13, 45 25, 45 48 L53 54 L11 54 Z" fill="url(#goldBellGrad)" stroke="#fef9c3" stroke-width="1.5"/>
                    <circle cx="32" cy="56" r="6" fill="#ca8a04"/>
                </svg>
            </div>
            <div>
                <h1 class="text-base sm:text-xl font-black tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 via-amber-400 to-teal-300">
                    RUNG CHUÔNG VÀNG NHÍ • BẢNG CHIA 2, 3, 4, 5
                </h1>
                <p class="text-[11px] sm:text-xs text-sky-200/90 font-bold">
                    Toán Lớp 2 • Khoa Học Tự Nhiên, Văn Hóa Việt & Song Ngữ Anh - Việt (CLIL)
                </p>
            </div>
        </div>

        <div class="flex items-center flex-wrap gap-2">
            <!-- Bật/Tắt Song ngữ Toán Tiếng Anh (CLIL) -->
            <button onclick="toggleBilingualMode()" class="px-3 py-1.5 rounded-xl text-xs font-extrabold bg-indigo-950/90 border border-sky-400/50 text-sky-200 hover:bg-indigo-900 transition flex items-center gap-1.5" title="Bật/Tắt phụ đề Tiếng Anh Toán học (CLIL)">
                <i class="fa-solid fa-language text-amber-300 text-sm"></i>
                <span id="bilingualStatusText">Song ngữ: BẬT</span>
            </button>

            <!-- Cẩm nang Bảng chia 2, 3, 4, 5 -->
            <button onclick="toggleStudyModal(true)" class="px-3 py-1.5 rounded-xl text-xs font-extrabold bg-teal-950/90 border border-teal-400/50 text-amber-200 hover:bg-teal-900 transition flex items-center gap-1.5">
                <i class="fa-solid fa-book-open-reader"></i>
                <span class="hidden sm:inline">Bảng Chia 2–5</span>
            </button>

            <!-- Nhạc nền đếm ngược Trường quay TV -->
            <button onclick="toggleStudioBGM()" class="px-3 py-1.5 rounded-xl text-xs font-extrabold bg-amber-950/85 border border-amber-400/50 text-amber-200 hover:bg-amber-900 transition flex items-center gap-1.5" title="Bật/Tắt nhạc nền đếm ngược trường quay truyền hình">
                <span id="tvEqIndicator" class="flex items-end gap-0.5 h-3 tv-eq-paused">
                    <span class="tv-eq-bar" style="animation-delay:0s"></span>
                    <span class="tv-eq-bar" style="animation-delay:0.18s"></span>
                    <span class="tv-eq-bar" style="animation-delay:0.36s"></span>
                </span>
                <span id="bgmBtnLabel" class="hidden sm:inline">Nhạc TV: BẬT</span>
            </button>

            <!-- Bật/Tắt âm thanh tổng -->
            <button onclick="toggleMasterSound()" class="p-2 px-3 rounded-xl text-sm font-bold bg-slate-900 border border-slate-600 text-amber-300 hover:bg-slate-800 transition" title="Bật/Tắt toàn bộ âm thanh">
                <i id="soundIcon" class="fa-solid fa-volume-high"></i>
            </button>

            <!-- Về Sảnh Chờ -->
            <button id="homeBtn" onclick="returnToLobby()" class="hidden px-3 py-1.5 rounded-xl text-xs font-extrabold bg-rose-950/85 border border-rose-500/60 text-rose-200 hover:bg-rose-900 transition">
                <i class="fa-solid fa-house mr-1"></i>Đổi Bảng
            </button>
        </div>
    </header>

    <!-- ================= KHU VỰC TRUNG TÂM ================= -->
    <main class="relative z-10 w-full max-w-6xl flex-1 flex flex-col justify-center my-3">

        <!-- ================= MÀN HÌNH 1: SẢNH CHỜ & CHỌN BẢNG CHIA LỚP 2 ================= -->
        <section id="lobbyScreen" class="w-full max-w-4xl mx-auto bg-slate-950/85 backdrop-blur-xl border-2 border-amber-400/45 rounded-3xl p-5 sm:p-8 shadow-2xl">
            <div class="text-center max-w-2xl mx-auto mb-6">
                <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-amber-500/20 border border-amber-400/40 text-amber-300 text-xs sm:text-sm font-extrabold mb-3">
                    <i class="fa-solid fa-award"></i> SÂN CHƠI TRÍ TUỆ TOÁN LỚP 2
                </div>
                <h2 class="text-2xl sm:text-4xl font-black text-white leading-tight mb-2">
                    Chinh Phục Đỉnh Cao <span class="text-amber-300">Bảng Chia 2, 3, 4, 5</span>
                </h2>
                <p class="text-slate-300 text-xs sm:text-base leading-relaxed">
                    Vượt qua <strong class="text-amber-300">20 nấc thang</strong> sinh động từ <em>mối liên hệ Nhân – Chia, Số bị chia – Số chia – Thương</em>, đơn vị đo lường đến thiên nhiên và văn hóa Việt Nam để ngân vang tiếng Chuông Vàng!
                </p>
            </div>

            <!-- Bước 1: Chọn Bảng Chia muốn thử thách -->
            <div class="mb-6">
                <label class="block text-center text-xs sm:text-sm font-extrabold uppercase tracking-wider text-sky-300 mb-3">
                    1. Chọn Bảng Chia Thi Đấu (Có thể chọn 1 hoặc nhiều bảng)
                </label>
                <div class="grid grid-cols-2 sm:grid-cols-6 gap-2.5 max-w-4xl mx-auto">
                    <button onclick="toggleDivTable(2)" id="divBtn-2" class="py-3 px-2.5 rounded-2xl font-black text-base border-2 transition flex flex-col items-center">
                        <span>🥢 Chia 2</span>
                        <span class="text-[11px] font-semibold opacity-85">2 : 2 → 20 : 2</span>
                    </button>
                    <button onclick="toggleDivTable(3)" id="divBtn-3" class="py-3 px-2.5 rounded-2xl font-black text-base border-2 transition flex flex-col items-center">
                        <span>🍀 Chia 3</span>
                        <span class="text-[11px] font-semibold opacity-85">3 : 3 → 30 : 3</span>
                    </button>
                    <button onclick="toggleDivTable(4)" id="divBtn-4" class="py-3 px-2.5 rounded-2xl font-black text-base border-2 transition flex flex-col items-center">
                        <span>🐱 Chia 4</span>
                        <span class="text-[11px] font-semibold opacity-85">4 : 4 → 40 : 4</span>
                    </button>
                    <button onclick="toggleDivTable(5)" id="divBtn-5" class="py-3 px-2.5 rounded-2xl font-black text-base border-2 transition flex flex-col items-center">
                        <span>⭐ Chia 5</span>
                        <span class="text-[11px] font-semibold opacity-85">5 : 5 → 50 : 5</span>
                    </button>
                    <button onclick="selectCoreGrade2Tables()" class="py-3 px-2.5 rounded-2xl font-extrabold text-xs border-2 border-emerald-400/60 bg-emerald-500/20 text-emerald-200 hover:bg-emerald-500/30 transition flex flex-col items-center justify-center" title="Chọn nhanh Bảng chia 2 và 5 trọng tâm SGK Toán Lớp 2 (GDPT 2018)">
                        <i class="fa-solid fa-check-double mb-1 text-amber-300"></i>
                        <span>Trọng Tâm 2 & 5</span>
                    </button>
                    <button onclick="selectAllDivTables()" class="py-3 px-2.5 rounded-2xl font-extrabold text-xs border-2 border-sky-400/60 bg-sky-500/20 text-sky-200 hover:bg-sky-500/30 transition flex flex-col items-center justify-center">
                        <i class="fa-solid fa-layer-group mb-1 text-amber-300"></i>
                        <span>Đủ Bảng 2–5</span>
                    </button>
                </div>
                <p id="tableWarning" class="hidden text-center text-rose-400 text-xs font-bold mt-2">
                    * Bé hãy chọn ít nhất 1 bảng chia trước khi bước lên sàn thi đấu nhé!
                </p>
            </div>

            <!-- Bước 2: Chọn Chế Độ Bảng Con Học Sinh -->
            <div class="mb-6 max-w-3xl mx-auto">
                <label class="block text-center text-xs sm:text-sm font-extrabold uppercase tracking-wider text-sky-300 mb-3">
                    2. Chọn Hình Thức Giơ Bảng Con Học Sinh
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <button onclick="selectGameMode('mixed')" id="modeCard-mixed" class="p-3.5 rounded-2xl border-2 text-left transition">
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-black text-amber-300 text-sm"><i class="fa-solid fa-star mr-1"></i>Chuẩn Sân Khấu</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-400 text-slate-950 font-black">Khuyên dùng</span>
                        </div>
                        <p class="text-xs text-slate-300">Câu 1–14 chọn nhanh A, B, C, D; Câu 15–20 tự viết thương lên bảng con hồi hộp!</p>
                    </button>

                    <button onclick="selectGameMode('mcq')" id="modeCard-mcq" class="p-3.5 rounded-2xl border-2 text-left transition">
                        <div class="font-black text-sky-300 text-sm mb-1"><i class="fa-solid fa-list-check mr-1.5"></i>Trắc Nghiệm 100%</div>
                        <p class="text-xs text-slate-300">Chọn 1 trong 4 đáp án A, B, C, D xuyên suốt cả 20 câu hỏi trên lớp.</p>
                    </button>

                    <button onclick="selectGameMode('slate')" id="modeCard-slate" class="p-3.5 rounded-2xl border-2 text-left transition">
                        <div class="font-black text-emerald-300 text-sm mb-1"><i class="fa-solid fa-chalkboard-user mr-1.5"></i>Tự Viết Bảng Con</div>
                        <p class="text-xs text-slate-300">Không hiện đáp án sẵn. Bé tự bấm số viết thương lên bảng con cả 20 câu.</p>
                    </button>
                </div>
            </div>

            <!-- Nhập tên thí sinh & Lên sàn đấu -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-xl mx-auto">
                <div class="relative w-full sm:w-2/3">
                    <i class="fa-solid fa-child-reaching absolute left-4 top-1/2 -translate-y-1/2 text-sky-400 text-lg"></i>
                    <input id="playerNameInput" type="text" maxlength="24" placeholder="Nhập tên thí sinh nhí (VD: Minh Anh 2A)..."
                        class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-slate-900 border-2 border-slate-600 focus:border-amber-400 focus:outline-none text-white font-bold placeholder-slate-400">
                </div>
                <button onclick="startGoldenBellArena()" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl font-black text-base sm:text-lg btn-gold-3d flex items-center justify-center gap-2 whitespace-nowrap">
                    <span>LÊN SÀN ĐẤU</span>
                    <i class="fa-solid fa-bell"></i>
                </button>
            </div>

            <!-- Nút mở Cẩm nang Ôn nhanh -->
            <div class="mt-5 pt-4 border-t border-slate-800 text-center">
                <button onclick="toggleStudyModal(true)" class="text-xs sm:text-sm font-extrabold text-sky-300 hover:text-sky-200 underline underline-offset-4 inline-flex items-center gap-1.5">
                    <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i> Mở Cẩm Nang Bảng Chia 2, 3, 4, 5 & Bí Kíp "Nhẩm Ngược Bảng Nhân"
                </button>
            </div>
        </section>

        <!-- ================= MÀN HÌNH 2: SÀN THI ĐẤU RUNG CHUÔNG VÀNG ================= -->
        <section id="arenaScreen" class="hidden w-full flex flex-col gap-3.5">

            <!-- Thanh Tiến Trình 20 Bậc Thang Tới Chuông Vàng -->
            <div class="bg-slate-950/90 border border-slate-700/80 rounded-2xl p-3 shadow-xl">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2 text-xs sm:text-sm">
                    <div class="flex items-center flex-wrap gap-2">
                        <span class="px-3 py-1 rounded-xl bg-sky-500/20 border border-sky-400/40 text-sky-200 font-black">
                            <i class="fa-solid fa-id-badge text-amber-300 mr-1"></i><span id="arenaPlayerName">Thí sinh Lớp 2</span>
                        </span>
                        <span id="stageBadgeLabel" class="px-3 py-1 rounded-xl bg-amber-500/20 border border-amber-400/40 text-amber-300 font-extrabold">
                            Chặng 1 • Khởi Động Bảng Chia
                        </span>
                    </div>

                    <div class="flex items-center gap-4 font-black">
                        <span class="text-orange-400" title="Chuỗi trả lời đúng liên tiếp">
                            <i class="fa-solid fa-fire mr-1"></i>Chuỗi: <span id="streakCount">0</span>
                        </span>
                        <span class="text-amber-300">
                            <i class="fa-solid fa-star mr-1"></i>Điểm: <span id="scoreCount">0</span>
                        </span>
                    </div>
                </div>

                <!-- 20 nấc thang -->
                <div id="ladderGrid" class="grid grid-cols-10 sm:grid-cols-20 gap-1"></div>
            </div>

            <!-- KHUNG SÂN KHẤU CHÍNH: ĐỒNG HỒ & GÓC THẦY CÔ (TRÁI) + BẢNG CON HỌC SINH (PHẢI) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">

                <!-- Cột Trái (3 phần): Đồng hồ đếm ngược + Góc Cô Giáo Song ngữ CLIL -->
                <div class="lg:col-span-3 flex flex-col justify-between gap-3 bg-slate-950/85 border border-slate-700/80 rounded-3xl p-4">
                    <div class="flex sm:flex-row lg:flex-col items-center justify-around gap-3 my-auto">
                        <!-- Đồng hồ vòng tròn -->
                        <div class="relative w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center shrink-0">
                            <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="42" stroke="#1e293b" stroke-width="9" fill="none"/>
                                <circle id="timerCircle" cx="50" cy="50" r="42" stroke="#22c55e" stroke-width="9" fill="none"
                                    stroke-dasharray="264" stroke-dashoffset="0" stroke-linecap="round" class="transition-all duration-300"/>
                            </svg>
                            <div class="absolute inset-0 flex flex-col items-center justify-center">
                                <span id="timerNumber" class="text-2xl sm:text-3xl font-black text-white">22</span>
