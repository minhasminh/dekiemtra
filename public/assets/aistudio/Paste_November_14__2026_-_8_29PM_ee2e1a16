        }

        function startArenaBGM() {
            stopArenaBGM();
            if (!soundEnabled || !studioBgmOn) return;
            ensureAudio();
            if (!audioCtx) return;

            bgmBeat = 0;
            updateEqVisual(true);

            const bassNotes = [50, 50, 57, 50, 53, 55, 57, 55];
            const marimbaNotes = [62, 69, 74, 69, 65, 69, 72, 69];

            bgmInterval = setInterval(() => {
                if (!soundEnabled || !studioBgmOn || !canAnswer || !audioCtx) return;
                const now = audioCtx.currentTime;
                const step = bgmBeat % 8;
                const urgent = (timeLeft <= 5);
                const shift = urgent ? 2 : 0;

                if (step % 2 === 0 || urgent) {
                    const bOsc = audioCtx.createOscillator();
                    const bFlt = audioCtx.createBiquadFilter();
                    const bGain = audioCtx.createGain();
                    bOsc.type = 'sawtooth';
                    bOsc.frequency.setValueAtTime(midiToHz(bassNotes[step] + shift - 12), now);
                    bFlt.type = 'lowpass';
                    bFlt.frequency.setValueAtTime(urgent ? 920 : 640, now);
                    bFlt.frequency.exponentialRampToValueAtTime(180, now + 0.16);
                    bGain.gain.setValueAtTime(urgent ? 0.072 : 0.052, now);
                    bGain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
                    bOsc.connect(bFlt);
                    bFlt.connect(bGain);
                    bGain.connect(masterBus);
                    bOsc.start(now);
                    bOsc.stop(now + 0.19);
                }

                const mOsc = audioCtx.createOscillator();
                const mGain = audioCtx.createGain();
                mOsc.type = 'sine';
                mOsc.frequency.setValueAtTime(midiToHz(marimbaNotes[step] + shift), now);
                mGain.gain.setValueAtTime(urgent ? 0.062 : 0.04, now);
                mGain.gain.exponentialRampToValueAtTime(0.0008, now + 0.12);
                mOsc.connect(mGain);
                mGain.connect(masterBus);
                if (step % 4 === 0) mGain.connect(hallEchoBus);
                mOsc.start(now);
                mOsc.stop(now + 0.13);

                bgmBeat++;
            }, 240);
        }

