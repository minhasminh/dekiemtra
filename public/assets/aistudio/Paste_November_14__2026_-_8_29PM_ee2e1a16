    <script>
        /* =========================================================================
           1. HỆ THỐNG ÂM THANH GAMESHOW TRUYỀN HÌNH RUNG CHUÔNG VÀNG (TV STUDIO DSP)
              - Tích hợp: Master Compressor, Arena Hall Reverb/Echo, Kèn đồng khai cuộc,
                Tiếng vỗ tay khán giả trường quay, Nhạc đếm ngược 120 BPM tự tăng tốc
                ở 5 giây cuối, Tiếng Cồng "Hết Giờ Giơ Bảng!", Gió bay Máy bay giấy
                và Đại Hồng Chung - Chuông Vàng 8 họa âm đồng thau vật lý.
           ========================================================================= */
        let audioCtx = null;
        let masterBus = null;
        let hallEchoBus = null;
        let noiseBuffer = null;

        let soundEnabled = true;
        let studioBgmOn = true;
        let bgmInterval = null;
        let bgmBeat = 0;

        function midiToHz(midi) {
            return 440 * Math.pow(2, (midi - 69) / 12);
        }

        function ensureAudio() {
            if (!audioCtx) {
                const Ctx = window.AudioContext || window.webkitAudioContext;
                if (Ctx) {
                    audioCtx = new Ctx();

                    // Bộ nén tín hiệu chuẩn truyền hình tránh vỡ âm
                    const compressor = audioCtx.createDynamicsCompressor();
                    compressor.threshold.setValueAtTime(-16, audioCtx.currentTime);
                    compressor.knee.setValueAtTime(24, audioCtx.currentTime);
                    compressor.ratio.setValueAtTime(6, audioCtx.currentTime);
                    compressor.attack.setValueAtTime(0.005, audioCtx.currentTime);
                    compressor.release.setValueAtTime(0.2, audioCtx.currentTime);
                    compressor.connect(audioCtx.destination);

                    masterBus = audioCtx.createGain();
                    masterBus.gain.value = 0.88;
                    masterBus.connect(compressor);

                    // Không gian vang nhà thi đấu lớn (Arena Hall Echo)
                    const delay = audioCtx.createDelay(1.0);
                    delay.delayTime.value = 0.19;
                    const fb = audioCtx.createGain();
                    fb.gain.value = 0.3;
                    const lp = audioCtx.createBiquadFilter();
                    lp.type = 'lowpass';
                    lp.frequency.value = 2800;

                    hallEchoBus = audioCtx.createGain();
                    hallEchoBus.gain.value = 0.34;
                    hallEchoBus.connect(delay);
                    delay.connect(lp);
                    lp.connect(fb);
                    fb.connect(delay);
                    lp.connect(masterBus);

                    // White Noise phục vụ tiếng vỗ tay khán giả & gió lướt máy bay giấy
                    const sr = audioCtx.sampleRate;
                    noiseBuffer = audioCtx.createBuffer(1, sr * 2, sr);
                    const ch = noiseBuffer.getChannelData(0);
                    for (let i = 0; i < ch.length; i++) {
                        ch[i] = Math.random() * 2 - 1;
                    }
                }
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function updateEqVisual(active) {
            const eq = document.getElementById('tvEqIndicator');
            if (!eq) return;
            if (active && soundEnabled && studioBgmOn) eq.classList.remove('tv-eq-paused');
            else eq.classList.add('tv-eq-paused');
        }

        function toggleMasterSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('soundIcon').className = soundEnabled
                ? 'fa-solid fa-volume-high'
                : 'fa-solid fa-volume-xmark text-slate-500';
            if (!soundEnabled) {
                stopArenaBGM();
                if ('speechSynthesis' in window) window.speechSynthesis.cancel();
            } else {
                playClickPop(660);
                if (!document.getElementById('arenaScreen').classList.contains('hidden') && canAnswer) {
                    startArenaBGM();
                }
            }
        }

        function toggleStudioBGM() {
            studioBgmOn = !studioBgmOn;
            document.getElementById('bgmBtnLabel').textContent = studioBgmOn ? 'Nhạc TV: BẬT' : 'Nhạc TV: TẮT';
            if (!studioBgmOn) {
                stopArenaBGM();
            } else {
                playClickPop(640);
                if (!document.getElementById('arenaScreen').classList.contains('hidden') && canAnswer) {
                    startArenaBGM();
                }
            }
        }

        function playClickPop(freq = 620) {
            if (!soundEnabled) return;
            ensureAudio();
